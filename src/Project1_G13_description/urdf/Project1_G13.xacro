<?xml version="1.0" ?>
<robot name="Project1_G13" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find Project1_G13_description)/urdf/materials.xacro" />
<xacro:include filename="$(find Project1_G13_description)/urdf/Project1_G13.ros2control" />
<xacro:include filename="$(find Project1_G13_description)/urdf/Project1_G13.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.0 0.0 0.03899115562540447" rpy="0 0 0"/>
    <mass value="8.930799060597675"/>
    <inertia ixx="0.012525" iyy="0.036154" izz="0.04567" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Project1_G13_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <geometry>
      <box size="0.20 0.12 0.06"/>
    </geometry>
  </collision>
</link>

<link name="camera_link_1">
  <inertial>
    <origin xyz="-0.039999999999999994 0.0 0.010000000000000002" rpy="0 0 0"/>
    <mass value="0.0628"/>
    <inertia ixx="4e-06" iyy="4e-06" izz="4e-06" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.11 -0.0 -0.0575" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Project1_G13_description)/meshes/camera_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.04 0 0.01" rpy="0 0 0"/>
    <geometry>
      <box size="0.08 0.04 0.02"/>
    </geometry>
  </collision>
</link>

<link name="lidar_link_1">
  <inertial>
    <origin xyz="0.0 0.0 0.0050000000000000044" rpy="0 0 0"/>
    <mass value="0.22195352097611892"/>
    <inertia ixx="5.2e-05" iyy="5.2e-05" izz="0.0001" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.0 -0.0775" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Project1_G13_description)/meshes/lidar_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.035" length="0.03"/>
    </geometry>
  </collision>
</link>

<link name="l2wheel_link_1">
  <inertial>
    <origin xyz="0.0 0.009999999999999995 0.0" rpy="0 0 0"/>
    <mass value="0.6936047530503714"/>
    <inertia ixx="0.000267" iyy="0.000488" izz="0.000267" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.075 -0.08 -0.0375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Project1_G13_description)/meshes/l2wheel_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0.01 0" rpy="1.57079632679 0 0"/>
    <geometry>
      <cylinder radius="0.0375" length="0.02"/>
    </geometry>
  </collision>
</link>

<link name="l1wheel_link_1">
  <inertial>
    <origin xyz="0.0 0.009999999999999995 0.0" rpy="0 0 0"/>
    <mass value="0.6936047530503714"/>
    <inertia ixx="0.000267" iyy="0.000488" izz="0.000267" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.075 -0.08 -0.0375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Project1_G13_description)/meshes/l1wheel_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0.01 0" rpy="1.57079632679 0 0"/>
    <geometry>
      <cylinder radius="0.0375" length="0.02"/>
    </geometry>
  </collision>
</link>

<link name="r1wheel_link_1">
  <inertial>
    <origin xyz="0.0 -0.009999999999999995 0.0" rpy="0 0 0"/>
    <mass value="0.6936047530503714"/>
    <inertia ixx="0.000267" iyy="0.000488" izz="0.000267" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.075 0.08 -0.0375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Project1_G13_description)/meshes/r1wheel_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 -0.01 0" rpy="1.57079632679 0 0"/>
    <geometry>
      <cylinder radius="0.0375" length="0.02"/>
    </geometry>
  </collision>
</link>

<link name="r2wheel_link_1">
  <inertial>
    <origin xyz="0.0 -0.009999999999999995 0.0" rpy="0 0 0"/>
    <mass value="0.6936047530503714"/>
    <inertia ixx="0.000267" iyy="0.000488" izz="0.000267" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.075 0.08 -0.0375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Project1_G13_description)/meshes/r2wheel_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 -0.01 0" rpy="1.57079632679 0 0"/>
    <geometry>
      <cylinder radius="0.0375" length="0.02"/>
    </geometry>
  </collision>
</link>

<joint name="camerajoint" type="fixed">
  <origin xyz="0.11 0.0 0.0575" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="camera_link_1"/>
</joint>

<joint name="lidar_joint" type="fixed">
  <origin xyz="0.0 0.0 0.0775" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lidar_link_1"/>
</joint>

<!--
  Ackermann running gear:
  - Rear wheels rotate about their axle (Y).
  - Front steering knuckles rotate about Z.
  - Front wheels rotate about Y relative to their steering knuckles.
-->
<link name="front_left_steering_link">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.01"/>
    <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" iyz="0" ixz="0"/>
  </inertial>
</link>

<link name="front_right_steering_link">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.01"/>
    <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" iyz="0" ixz="0"/>
  </inertial>
</link>

<joint name="rear_left_wheel_joint" type="continuous">
  <origin xyz="-0.075 0.08 0.0375" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="l2wheel_link_1"/>
  <axis xyz="0 1 0"/>
  <limit effort="40.0" velocity="30.0"/>
  <dynamics damping="0.05" friction="0.01"/>
</joint>

<joint name="front_left_steering_joint" type="revolute">
  <origin xyz="0.075 0.08 0.0375" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="front_left_steering_link"/>
  <axis xyz="0 0 1"/>
  <limit lower="-0.60" upper="0.60" effort="20.0" velocity="2.0"/>
  <dynamics damping="0.10" friction="0.05"/>
</joint>

<joint name="front_left_wheel_joint" type="continuous">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="front_left_steering_link"/>
  <child link="l1wheel_link_1"/>
  <axis xyz="0 1 0"/>
  <limit effort="40.0" velocity="30.0"/>
  <dynamics damping="0.05" friction="0.01"/>
</joint>

<joint name="front_right_steering_joint" type="revolute">
  <origin xyz="0.075 -0.08 0.0375" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="front_right_steering_link"/>
  <axis xyz="0 0 1"/>
  <limit lower="-0.60" upper="0.60" effort="20.0" velocity="2.0"/>
  <dynamics damping="0.10" friction="0.05"/>
</joint>

<joint name="front_right_wheel_joint" type="continuous">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="front_right_steering_link"/>
  <child link="r1wheel_link_1"/>
  <axis xyz="0 1 0"/>
  <limit effort="40.0" velocity="30.0"/>
  <dynamics damping="0.05" friction="0.01"/>
</joint>

<joint name="rear_right_wheel_joint" type="continuous">
  <origin xyz="-0.075 -0.08 0.0375" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="r2wheel_link_1"/>
  <axis xyz="0 1 0"/>
  <limit effort="40.0" velocity="30.0"/>
  <dynamics damping="0.05" friction="0.01"/>
</joint>

</robot>
